# Environment variables for paper2md
# Copy this file to .env and fill in your values

# OpenAI API key for LLM summarization (REQUIRED)
# With the default OpenRouter base URL, use your OpenRouter key (sk-or-...)
OPENAI_API_KEY=

# Model to use (default: google/gemini-3.1-flash-lite)
OPENAI_MODEL=google/gemini-3.1-flash-lite

# API base URL (default: https://openrouter.ai/api/v1)
# Examples:
#   OpenRouter (default): https://openrouter.ai/api/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model for figure descriptions (must accept image input; defaults to OPENAI_MODEL)
# OPENAI_VISION_MODEL=
